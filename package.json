{
  "name": "requirement-review-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write app components lib tests scripts *.json *.ts *.mjs *.md",
    "format:check": "prettier --check app components lib tests scripts *.json *.ts *.mjs *.md",
    "smoke": "node --experimental-strip-types scripts/smoke.mjs",
    "lint:specs": "node scripts/harness/check-specs.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/jpn": "^1.0.0",
    "mammoth": "1.13.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.12",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "type": "module",
  "allowScripts": {
    "tesseract.js": false
  }
}
