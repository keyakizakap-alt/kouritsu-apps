{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "production" }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
